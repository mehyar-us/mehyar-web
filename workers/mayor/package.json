{
  "name": "mehyar-mayor",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8790",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build:web": "vite build",
    "build": "npm run build:web && wrangler deploy --dry-run --outdir dist",
    "db:local": "wrangler d1 migrations apply AGENT_DB --local"
  },
  "dependencies": {
    "@cloudflare/voice": "0.5.0",
    "@cloudflare/voice-twilio": "0.1.1",
    "agents": "0.24.0",
    "ai": "7.0.109",
    "better-auth": "1.7.5",
    "jose": "6.2.12",
    "lucide": "0.453.0",
    "workers-ai-provider": "4.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.10",
    "@cloudflare/workers-types": "5.20260916.1",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.132.0"
  }
}
