{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mehyar-mayor",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat","global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory":"./public","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*","/agents/*","/mcp","/business-audit","/business-audit/*","/sales","/sales/*"]},
  "vars": {"APP_ORIGIN": "http://127.0.0.1:5175", "ENVIRONMENT": "local"},
  "ai": {"binding": "AI"},
  "d1_databases": [{"binding": "AGENT_DB", "database_name": "mehyar-mayor", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}],
  "durable_objects": {"bindings": [{"name": "MAYOR_VOICE", "class_name": "MayorVoice"},{"name":"MAYOR_PHONE","class_name":"MayorPhone"}]},
  "migrations": [{"tag": "mayor-v1", "new_sqlite_classes": ["MayorVoice"]},{"tag":"mayor-v2","new_sqlite_classes":["MayorPhone"]}],
  "observability": {"enabled": true, "head_sampling_rate": 0.1}
}
