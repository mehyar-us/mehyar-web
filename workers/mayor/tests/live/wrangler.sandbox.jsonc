{
 "name":"mayor-local-billing-verification",
 "main":"sandbox-worker.ts",
 "compatibility_date":"2026-09-22",
 "compatibility_flags":["nodejs_compat","global_fetch_strictly_public"],
 "workers_dev":false,
 "assets":{"directory":"../../public","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":true},
 "vars":{"APP_ORIGIN":"http://127.0.0.1:5195","ENVIRONMENT":"local-sandbox"},
 "ai":{"binding":"AI"},
 "d1_databases":[{"binding":"AGENT_DB","database_name":"mayor-local-sandbox","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"../../migrations"}],
 "durable_objects":{"bindings":[{"name":"MAYOR_VOICE","class_name":"MayorVoice"},{"name":"MAYOR_PHONE","class_name":"MayorPhone"}]},
 "migrations":[{"tag":"v1","new_sqlite_classes":["MayorVoice","MayorPhone"]}]
}
